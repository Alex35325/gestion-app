<Window x:Class="GestionApp.Dialogs.RevenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revenu" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Date *" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DatePicker x:Name="DatePickerBox" Grid.Row="1" Margin="0,0,0,12" Padding="6"/>

        <TextBlock Text="Client (rentabilité)" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="ClientCombo" Grid.Row="3" Margin="0,0,0,12" Padding="6"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Véhicule (rentabilité)" Grid.Row="4" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="VehiculeCombo" Grid.Row="5" Margin="0,0,0,12" Padding="6"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Produit (rentabilité)" Grid.Row="6" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="ProduitCombo" Grid.Row="7" Margin="0,0,0,12" Padding="6"
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Montant *" Grid.Row="8" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="MontantBox" Grid.Row="9" Margin="0,0,0,12" Padding="6"/>

        <TextBlock Text="Catégorie" Grid.Row="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="CategorieCombo" Grid.Row="11" Margin="0,0,0,12" Padding="6"/>

        <TextBlock Text="Description" Grid.Row="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionBox" Grid.Row="13" Margin="0,0,0,12" Padding="6"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Width="90" Padding="6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Enregistrer" Width="110" Padding="6" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
