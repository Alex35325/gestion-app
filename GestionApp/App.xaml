<Application x:Class="GestionApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:views="clr-namespace:GestionApp.Views"
             xmlns:conv="clr-namespace:GestionApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>

        <!-- Maps each screen's ViewModel type to its View — the ContentControl in
             MainWindow.xaml just binds Content to CurrentViewModel and WPF picks
             the matching template below automatically. Two ViewModel types
             (Revenus/Dépenses) intentionally share one View. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RevenusViewModel}">
            <views:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepensesViewModel}">
            <views:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiculesInfoViewModel}">
            <views:VehiculesInfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventaireViewModel}">
            <views:InventaireView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RentabiliteViewModel}">
            <views:RentabiliteView/>
        </DataTemplate>
    </Application.Resources>
</Application>
