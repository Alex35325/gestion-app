<UserControl x:Class="GestionApp.Views.RentabiliteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Rentabilité" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Par véhicule" IsChecked="{Binding IsVehiculeType}" GroupName="RentaType" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton Content="Par produit" IsChecked="{Binding IsProduitType}" GroupName="RentaType" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Revenus" Binding="{Binding Revenus, StringFormat={}{0:C}, ConverterCulture=fr-CA}" Width="Auto"/>
                <DataGridTextColumn Header="Dépenses" Binding="{Binding Depenses, StringFormat={}{0:C}, ConverterCulture=fr-CA}" Width="Auto"/>
                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat={}{0:C}, ConverterCulture=fr-CA}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
