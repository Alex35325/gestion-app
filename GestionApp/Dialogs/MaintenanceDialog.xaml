<Window x:Class="GestionApp.Dialogs.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entretien" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" Width="90" Padding="6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Enregistrer" Width="110" Padding="6" IsDefault="True" Click="Save_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Véhicule *" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="VehiculeCombo" Margin="0,0,0,12" Padding="6" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Text="Type d'entretien" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="TypeCombo" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Date effectuée" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DatePicker x:Name="DateBox" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Prochaine échéance" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DatePicker x:Name="NextDueDateBox" Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NotesBox" Padding="6" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </DockPanel>
</Window>
