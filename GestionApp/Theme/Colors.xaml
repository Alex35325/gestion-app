<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same emerald accent as the website's CSS "accent" variable, so the
         desktop app and the site feel like the same product. Extra hues
         (danger/warning/info/purple) give semantic meaning to actions and
         status badges instead of leaving everything gray. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#059669"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#047857"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#047857"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE2E1"/>
    <SolidColorBrush x:Key="DangerSoftTextBrush" Color="#8A2A24"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF0D5"/>
    <SolidColorBrush x:Key="WarningSoftTextBrush" Color="#7A5A10"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E9EEF9"/>
    <SolidColorBrush x:Key="InfoSoftTextBrush" Color="#1E3A8A"/>

    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#F3F0FA"/>
    <SolidColorBrush x:Key="PurpleSoftTextBrush" Color="#5B21B6"/>

    <SolidColorBrush x:Key="NeutralBrush" Color="#475569"/>
    <SolidColorBrush x:Key="NeutralDarkBrush" Color="#334155"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFBFA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8DE"/>
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#F2FBF7"/>
    <SolidColorBrush x:Key="NavBorderBrush" Color="#D8EFE4"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E1F6EC"/>

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#065F46" Offset="0"/>
        <GradientStop Color="#1F2937" Offset="1"/>
    </LinearGradientBrush>

    <!-- Rotating palette for the nav "dot" markers and dashboard widget accents —
         gives each section its own identity at a glance. -->
    <SolidColorBrush x:Key="NavDotDashboard" Color="#7C3AED"/>
    <SolidColorBrush x:Key="NavDotClients" Color="#2563EB"/>
    <SolidColorBrush x:Key="NavDotVehicules" Color="#D97706"/>
    <SolidColorBrush x:Key="NavDotInventaire" Color="#059669"/>
    <SolidColorBrush x:Key="NavDotRentabilite" Color="#DC2626"/>

</ResourceDictionary>
